diff --git a/Docker.rust b/Docker.rust
index 5dc5058..0000000 100644
--- a/Docker.rust
+++ b/Docker.rust
@@ -34,6 +34,7 @@ RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --
     . $HOME/.cargo/env && \
     rustup component add rust-src && \
+    rustup target add aarch64-unknown-linux-gnu && \
     cargo install bindgen-cli cbindgen
 
 ENV PATH="/root/.cargo/bin:${PATH}"
diff --git a/build-switch.sh b/build-switch.sh
index 64bb44a..0000000 100755
--- a/build-switch.sh
+++ b/build-switch.sh
@@ -1,8 +1,12 @@
 #!/bin/bash
 set -e
 
-IMAGE_NAME="devkitpro-mesa-rust"
+IMAGE_NAME="${MESA_SWITCH_IMAGE_NAME:-devkitpro-mesa-rust}"
 CONTAINER_NAME="mesa-switch-build"
+export MESA_SWITCH_RUST_TARGET="${MESA_SWITCH_RUST_TARGET:-aarch64-unknown-linux-gnu}"
+
+DOCKER_SECURITY_ARGS=()
+if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = "Enforcing" ]; then
+    DOCKER_SECURITY_ARGS+=(--security-opt label=disable)
+fi
 
 # Build the Docker image if needed.
 if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
@@ -13,8 +17,10 @@ fi
 # Start the build container.
 docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
 docker run -d --name "$CONTAINER_NAME" \
+    "${DOCKER_SECURITY_ARGS[@]}" \
+    -e MESA_SWITCH_RUST_TARGET="$MESA_SWITCH_RUST_TARGET" \
     -v "$(pwd):/project" --workdir "/project" \
     "$IMAGE_NAME" sleep infinity
